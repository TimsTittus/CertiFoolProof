# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/certifoolproof"
DIRECT_URL="postgresql://postgres:password@localhost:5432/certifoolproof"

# ===========================================
# Auth Configuration (Better-Auth)
# ===========================================
# Secret used for signing sessions and JWT tokens (e.g. openssl rand -base64 32)
BETTER_AUTH_SECRET="your-secret-here"
AUTH_SECRET="your-secret-here"

# Public base URL; embedded into certificate QR codes as <URL>/verify/<id>
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# ===========================================
# Role Registration Passwords
# ===========================================
ADMIN_PASSWORD=your-admin-password
FACULTY_PASSWORD=your-faculty-password
CLUB_PASSWORD=your-club-password