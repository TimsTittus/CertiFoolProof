// ===========================================
// CertiFoolProof - Prisma Schema
// ===========================================
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================================
// Enums
// ===========================================

/// User roles for Role-Based Access Control (RBAC)
enum UserRole {
  ADMIN   // Full system access, user management, analytics
  FACULTY // Issue certificates for academic programs
  CLUB    // Issue certificates for club events/activities
}

/// Certificate lifecycle status
enum CertificateStatus {
  ACTIVE  // Valid and verifiable
  REVOKED // Manually revoked by issuer
  EXPIRED // Past expiration date
}

// ===========================================
// Models
// ===========================================

/// User model with RBAC support
/// Supports Admin, Faculty, and Club roles
model User {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  password   String   // bcrypt hashed
  role       UserRole @default(FACULTY)
  department String?  // Optional department/club affiliation

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  certificates Certificate[] // Certificates issued by this user

  // Indexes for performance
  @@index([role])
  @@index([email])
  @@map("users")
}

/// Certificate model with hash verification support
/// Stores certificate data with SHA-256 hash for integrity verification
model Certificate {
  id             String            @id @default(uuid())
  certificateId  String            @unique // Public ID format: CFP-2026-XXXXX
  recipientName  String
  recipientEmail String
  title          String            // Certificate title (e.g., "Workshop Completion")
  description    String?           // Optional detailed description
  issuedAt       DateTime          @default(now())
  expiresAt      DateTime?         // Optional expiration date
  dataHash       String            // SHA-256 hash of certificate data
  qrCodeData     String            // QR code payload (verification URL)
  status         CertificateStatus @default(ACTIVE)

  // Issuer relation
  issuerId String
  issuer   User   @relation(fields: [issuerId], references: [id], onDelete: Restrict)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Verification tracking
  verificationCount Int      @default(0)
  lastVerifiedAt    DateTime?

  // Indexes for performance
  @@index([certificateId])
  @@index([recipientEmail])
  @@index([issuerId])
  @@index([status])
  @@index([issuedAt])
  @@map("certificates")
}

/// Verification log for analytics (Phase 6)
model VerificationLog {
  id            String   @id @default(uuid())
  certificateId String
  verifiedAt    DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  success       Boolean  @default(true)

  @@index([certificateId])
  @@index([verifiedAt])
  @@map("verification_logs")
}
